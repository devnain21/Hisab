# EAS reads only this file (not nested .gitignore files), so it repeats every rule the build must skip.

# Root .gitignore
.env
.env.*
!.env.example
**/firebase-service-account.json
.idea/
.vscode/
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
*.tsbuildinfo
/build
dist/
*token.json*
*credentials.json*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem
__pycache__/
*pyc*
venv/
.venv/
.cache/
memory/test_credentials.md
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz

# Not needed by the app build
/backend/
/.emergent/
/build*.log

# frontend/.gitignore
frontend/.expo/
frontend/.metro-cache/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
frontend/android/
frontend/ios/
frontend/credentials/
frontend/.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
frontend/.metro-health-check*
frontend/app-example
