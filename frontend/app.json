{
  "expo": {
    "name": "Hisab",
    "slug": "nain-hisab",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nainhisab",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bc4207c9-dc20-4088-a255-a5d628468a62",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nainphotostate.hisab",
      "usesAppleSignIn": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00796B"
      },
      "package": "com.nainphotostate.hisab",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "nainhisab"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "@react-native-google-signin/google-signin",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#00796B"
        }
      ],
      "./plugins/with-recents-privacy",
      [
        "expo-image-picker",
        {
          "photosPermission": "रसीद पर दुकान का लोगो लगाने के लिए फ़ोटो चुनने की अनुमति दें।",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "नया ग्राहक जोड़ने के लिए फ़ोन के संपर्कों की अनुमति दें।"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc4207c9-dc20-4088-a255-a5d628468a62"
      }
    },
    "owner": "devnain21"
  }
}
